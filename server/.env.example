# ClickUp export-on-close integration (optional — closing a retro works fine without it)
# Personal API Token: ClickUp avatar (bottom-left) > Settings > Apps > API Token
CLICKUP_API_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Workspace ("Team") ID — the number in the URL right after app.clickup.com/
CLICKUP_WORKSPACE_ID=1234567

# Fallback location for the Doc when no sprint is selected. Defaults to the
# workspace root. Set CLICKUP_PARENT_ID to a Space/Folder/List id and
# CLICKUP_PARENT_TYPE to match: 4=Space, 5=Folder, 6=List, 12=Workspace (default).
# CLICKUP_PARENT_ID=98765
# CLICKUP_PARENT_TYPE=4

# Where the sprint picker looks for sprints when closing a retro.
# Defaults shown below — override only if your Space/folder is named differently.
# CLICKUP_SPACE_NAME=btr.tech
# CLICKUP_SPRINTS_FOLDER_NAME=Sprints

# Database (optional). Defaults to a local embedded SQLite file at
# server/db/retro.db — fine for local dev, but wiped on every Render
# deploy/restart since the filesystem there is ephemeral.
# For real persistence, point this at a free Turso (libSQL) database instead:
# create one at turso.tech, then set both of these from its dashboard.
# DB_URL=libsql://your-db-your-org.turso.io
# DB_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...
